<!DOCTYPE html>
<html lang="es">
  <%- include('../partials/head', { title: 'Editar turno', tomSelect: true }) %>
  <body>
    <div class="layout">
      <%- include('../partials/sidebar') %>

      <main class="main-content">
        <%- include('../partials/header', { title: 'Editar turno' }) %>

        <section class="content-box">
          <h2>Editar turno</h2>

          <% if (error) { %>
            <p class="mb-md" style="color: var(--color-danger);"><%= error %></p>
          <% } %>

          <form action="/turnos/<%= turno.id %>/editar" method="POST" class="turno-form">
            <div class="form-grid">
              <div>
                <label>Fecha</label>
                <input
                  type="date"
                  name="fecha"
                  value="<%= new Date(turno.fecha).toISOString().split('T')[0] %>"
                  required
                />
              </div>

              <div>
                <label>Hora</label>
                <input
                  type="time"
                  name="hora"
                  value="<%= turno.hora %>"
                  required
                />
              </div>

              <div>
                <label>Empleada</label>
                <select name="id_empleado" id="id_empleado" required>
                  <% empleados.forEach(empleado => { %>
                    <option
                      value="<%= empleado.id %>"
                      data-porcentaje="<%= empleado.porcentaje_ganancia || 0 %>"
                      <%= Number(turno.id_empleado) === Number(empleado.id) ? 'selected' : '' %>
                    >
                      <%= empleado.nombre %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <div>
                <label>Clienta</label>
                <select name="id_cliente" id="id_cliente" required>
                  <% clientes.forEach(cliente => { %>
                    <option
                      value="<%= cliente.id %>"
                      data-search="<%= (cliente.nombre + ' ' + (cliente.apellido || '')).trim() %>"
                      <%= Number(turno.id_cliente) === Number(cliente.id) ? 'selected' : '' %>
                    >
                      <%= cliente.nombre %> <%= cliente.apellido || '' %> - <%= cliente.telefono || '' %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <div>
                <label>Servicio</label>
                <select name="id_servicio" id="id_servicio" required>
                  <% servicios.forEach(servicio => { %>
                    <option
                      value="<%= servicio.id %>"
                      data-precio="<%= servicio.precio || 0 %>"
                      data-duracion="<%= servicio.duracion_sugerida || 30 %>"
                      data-search="<%= servicio.descripcion %>"
                      <%= Number(turno.id_servicio) === Number(servicio.id) ? 'selected' : '' %>
                    >
                      <%= servicio.descripcion %> - $<%= servicio.precio || 0 %> - <%= servicio.duracion_sugerida || 30 %> min
                    </option>
                  <% }) %>
                </select>
              </div>

              <div>
                <label>Costo</label>
                <input
                  type="number"
                  step="0.01"
                  min="0"
                  name="costo"
                  id="costo"
                  value="<%= turno.costo %>"
                  required
                />
              </div>

              <div>
                <label>Duración (minutos)</label>
                <input
                  type="number"
                  name="duracion"
                  id="duracion"
                  min="10"
                  step="10"
                  value="<%= turno.duracion || 30 %>"
                  required
                />
              </div>

              <div>
                <label>Estado de pago</label>
                <select name="estado" id="estado">
                  <option value="Pendiente" <%= turno.estado === 'Pendiente' ? 'selected' : '' %>>
                    No pagado
                  </option>
                  <option value="Parcial" <%= turno.estado === 'Parcial' ? 'selected' : '' %>>
                    Pago parcial / seña
                  </option>
                  <option value="Pagado" <%= turno.estado === 'Pagado' ? 'selected' : '' %>>
                    Pagado
                  </option>
                </select>
              </div>

              <div>
                <label>Monto abonado</label>
                <input
                  type="number"
                  step="0.01"
                  min="0"
                  name="monto_abonado"
                  id="monto_abonado"
                  value="<%= turno.monto_abonado || 0 %>"
                />
              </div>

              <div id="grupo-metodo-pago" style="display: none;">
                <label>Método de pago</label>
                <select name="metodo_pago" id="metodo_pago">
                  <option value="">Seleccionar...</option>
                  <option value="efectivo" <%= metodoPago.metodo_pago === 'efectivo' ? 'selected' : '' %>>Efectivo</option>
                  <option value="transferencia" <%= metodoPago.metodo_pago === 'transferencia' ? 'selected' : '' %>>Transferencia</option>
                  <option value="mixto" <%= metodoPago.metodo_pago === 'mixto' ? 'selected' : '' %>>Mixto (efectivo + transferencia)</option>
                </select>
              </div>

              <div id="grupo-pago-mixto" style="display: none; grid-column: 1 / -1;">
                <div class="form-grid" style="grid-template-columns: 1fr 1fr;">
                  <div>
                    <label>Monto en efectivo</label>
                    <input
                      type="number"
                      step="0.01"
                      min="0"
                      name="monto_efectivo"
                      id="monto_efectivo"
                      value="<%= metodoPago.monto_efectivo %>"
                    />
                  </div>
                  <div>
                    <label>Monto en transferencia</label>
                    <input
                      type="number"
                      step="0.01"
                      min="0"
                      name="monto_transferencia"
                      id="monto_transferencia"
                      value="<%= metodoPago.monto_transferencia %>"
                    />
                  </div>
                </div>
                <p id="aviso-mixto" style="font-size: 13px; margin-top: 4px;"></p>
              </div>

              <div>
                <label>% Ganancia de la empleada en este turno</label>
                <input
                  type="number"
                  step="0.01"
                  min="0"
                  max="100"
                  name="porcentaje_ganancia"
                  id="porcentaje_ganancia"
                  value="<%= turno.porcentaje_ganancia || 0 %>"
                />
              </div>

              <div>
                <label>Propina</label>
                <input
                  type="number"
                  name="propina"
                  step="0.01"
                  min="0"
                  placeholder="Ej: 1000"
                  value="<%= Number(turno.propina || 0) %>"
                />
              </div>

              <div style="grid-column: 1 / -1;">
                <label style="display: flex; align-items: center; gap: 8px; max-width: fit-content;">
                  <input
                    type="checkbox"
                    name="actualizar_servicio_base"
                    value="1"
                  />
                  Actualizar también el precio y la duración sugerida del servicio para próximos turnos
                </label>
              </div>
            </div>

            <div class="mt-lg content-box" style="background: var(--color-surface-soft); box-shadow: none;">
              <h3>Resumen de pago</h3>
              <p><strong>Costo total:</strong> $<span id="resumen_costo">0</span></p>
              <p><strong>Seña / abonado:</strong> $<span id="resumen_abonado">0</span></p>
              <p><strong>Saldo pendiente:</strong> $<span id="resumen_resta">0</span></p>
              <p><strong>Estado final:</strong> <span id="resumen_estado">Pendiente</span></p>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary" id="btn-guardar">Guardar cambios</button>
              <a href="/agenda?fecha=<%= new Date(turno.fecha).toISOString().split('T')[0] %>" class="btn btn-secondary">
                Cancelar
              </a>
            </div>
          </form>

          <form
            action="/turnos/<%= turno.id %>/eliminar"
            method="POST"
            id="form-eliminar"
            class="mt-md"
          >
            <button
              type="button"
              class="btn btn-danger"
              onclick="showConfirm('¿Seguro que querés eliminar este turno? Esta acción no se puede deshacer.', function() { document.getElementById('form-eliminar').submit(); })"
            >
              Eliminar turno
            </button>
          </form>
        </section>
      </main>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const empleadoSelectEl = document.getElementById("id_empleado");
        const porcentajeGananciaInput = document.getElementById("porcentaje_ganancia");
        const servicioSelectEl = document.getElementById("id_servicio");
        const costoInput = document.getElementById("costo");
        const duracionInput = document.getElementById("duracion");
        const estadoSelect = document.getElementById("estado");
        const montoAbonadoInput = document.getElementById("monto_abonado");
        const resumenEstado = document.getElementById("resumen_estado");
        const resumenCosto = document.getElementById("resumen_costo");
        const resumenAbonado = document.getElementById("resumen_abonado");
        const resumenResta = document.getElementById("resumen_resta");
        const grupoMetodoPago = document.getElementById("grupo-metodo-pago");
        const grupoPagoMixto = document.getElementById("grupo-pago-mixto");
        const metodoPagoSelect = document.getElementById("metodo_pago");
        const montoEfectivoInput = document.getElementById("monto_efectivo");
        const montoTransferenciaInput = document.getElementById("monto_transferencia");
        const avisoMixto = document.getElementById("aviso-mixto");

        function numero(valor) {
          const n = Number(valor);
          return isNaN(n) ? 0 : n;
        }

        function actualizarResumen() {
          const costo = numero(costoInput.value);
          let abonado = numero(montoAbonadoInput.value);

          if (abonado < 0) {
            abonado = 0;
            montoAbonadoInput.value = 0;
          }

          if (abonado > costo) {
            abonado = costo;
            montoAbonadoInput.value = costo;
          }

          const estado = estadoSelect.value;

          if (estado === "Pendiente") {
            abonado = 0;
            montoAbonadoInput.value = 0;
            montoAbonadoInput.readOnly = true;
          } else if (estado === "Pagado") {
            abonado = costo;
            montoAbonadoInput.value = costo;
            montoAbonadoInput.readOnly = true;
          } else {
            montoAbonadoInput.readOnly = false;
          }

          const resta = Math.max(costo - abonado, 0);

          resumenCosto.textContent = costo.toLocaleString("es-AR");
          resumenAbonado.textContent = abonado.toLocaleString("es-AR");
          resumenResta.textContent = resta.toLocaleString("es-AR");
          resumenEstado.textContent = estado;

          if (estado === "Pendiente") {
            grupoMetodoPago.style.display = "none";
            grupoPagoMixto.style.display = "none";
          } else {
            grupoMetodoPago.style.display = "";
            grupoPagoMixto.style.display = metodoPagoSelect.value === "mixto" ? "" : "none";
          }

          validarMixtoVisual();
        }

        function validarMixtoVisual() {
          if (metodoPagoSelect.value !== "mixto") {
            avisoMixto.textContent = "";
            return;
          }

          const efectivo = numero(montoEfectivoInput.value);
          const transferencia = numero(montoTransferenciaInput.value);
          const abonado = numero(montoAbonadoInput.value);

          if (Math.abs(efectivo + transferencia - abonado) > 0.01) {
            avisoMixto.textContent =
              "La suma de efectivo ($" + efectivo.toLocaleString("es-AR") +
              ") y transferencia ($" + transferencia.toLocaleString("es-AR") +
              ") no coincide con el monto abonado ($" + abonado.toLocaleString("es-AR") + ").";
            avisoMixto.style.color = "var(--color-danger)";
          } else {
            avisoMixto.textContent = "";
          }
        }

        function aplicarServicio(value) {
          if (!value) return;
          const opt = Array.from(servicioSelectEl.options).find((o) => o.value === value);
          if (opt) {
            const precio = opt.dataset.precio;
            const duracion = opt.dataset.duracion;
            if (precio) costoInput.value = precio;
            if (duracion) duracionInput.value = duracion;
          }
          actualizarResumen();
        }

        empleadoSelectEl.addEventListener("change", function () {
          const opt = empleadoSelectEl.options[empleadoSelectEl.selectedIndex];
          if (opt && opt.dataset.porcentaje !== undefined) {
            porcentajeGananciaInput.value = opt.dataset.porcentaje;
          }
        });

        new TomSelect("#id_cliente", {
          placeholder: "Buscar clienta...",
          allowEmptyOption: true,
        });

        new TomSelect("#id_servicio", {
          placeholder: "Buscar servicio...",
          allowEmptyOption: true,
          onChange: function (value) {
            aplicarServicio(value);
          },
        });

        function autoCompletarMixto(origen) {
          const abonado = numero(montoAbonadoInput.value);
          if (origen === "efectivo") {
            const efectivo = numero(montoEfectivoInput.value);
            montoTransferenciaInput.value = Math.max(abonado - efectivo, 0).toFixed(2);
          } else {
            const transferencia = numero(montoTransferenciaInput.value);
            montoEfectivoInput.value = Math.max(abonado - transferencia, 0).toFixed(2);
          }
          validarMixtoVisual();
        }

        costoInput.addEventListener("input", actualizarResumen);
        estadoSelect.addEventListener("change", actualizarResumen);
        montoAbonadoInput.addEventListener("input", actualizarResumen);
        metodoPagoSelect.addEventListener("change", actualizarResumen);
        montoEfectivoInput.addEventListener("input", function () {
          autoCompletarMixto("efectivo");
        });
        montoTransferenciaInput.addEventListener("input", function () {
          autoCompletarMixto("transferencia");
        });

        actualizarResumen();
      });

      document.querySelector("form").addEventListener("submit", function() {
      const btn = document.getElementById("btn-guardar");
      btn.disabled = true;
      btn.textContent = "Guardando...";
    });

    </script>
      <%- include('../partials/footer') %>
</body>
</html>