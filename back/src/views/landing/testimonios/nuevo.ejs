<!DOCTYPE html>
<html lang="es">
  <%- include('../../partials/head', { title: 'Nuevo testimonio' }) %>
  <body>
    <div class="layout">
      <%- include('../../partials/sidebar') %>

      <main class="main-content">
        <%- include('../../partials/header', { title: 'Nuevo testimonio' }) %>

        <section class="content-box">
          <div class="topbar mb-md">
            <div>
              <h2 class="mb-sm">+ Nuevo testimonio</h2>
              <p class="text-muted">Agregá un comentario de clienta a la landing.</p>
            </div>
            <div class="page-actions">
              <a href="/landing" class="btn btn-secondary">← Volver</a>
            </div>
          </div>

          <% if (error) { %>
            <div class="alert alert-error mb-md"><%= error %></div>
          <% } %>

          <form method="POST" action="/landing/testimonios/nuevo" enctype="multipart/form-data">
            <div class="form-group">
              <label class="form-label">Nombre <span class="text-muted">(obligatorio)</span></label>
              <input type="text" name="nombre" placeholder="Ej: María García" required>
            </div>

            <div class="form-group">
              <label class="form-label">Comentario <span class="text-muted">(obligatorio)</span></label>
              <textarea name="texto" rows="4" placeholder="Escribí el comentario de la clienta" required></textarea>
            </div>

            <div class="form-group">
              <label class="form-label">Estrellas</label>
              <select name="estrellas">
                <option value="5" selected>⭐⭐⭐⭐⭐ (5)</option>
                <option value="4">⭐⭐⭐⭐ (4)</option>
                <option value="3">⭐⭐⭐ (3)</option>
                <option value="2">⭐⭐ (2)</option>
                <option value="1">⭐ (1)</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Foto de perfil <span class="text-muted">(opcional)</span></label>
              <input type="file" name="foto" accept="image/*">
            </div>

            <div class="form-group">
              <label class="form-label">Orden de aparición</label>
              <input type="number" name="orden" value="0" min="0" style="max-width: 100px;">
            </div>

            <div class="form-group">
              <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input type="checkbox" name="activo" checked>
                <span>Visible en la landing</span>
              </label>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Crear testimonio</button>
              <a href="/landing" class="btn btn-secondary">Cancelar</a>
            </div>
          </form>
        </section>
      </main>
    </div>
  </body>
</html>