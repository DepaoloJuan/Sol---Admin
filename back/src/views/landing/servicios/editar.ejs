<!DOCTYPE html>
<html lang="es">
  <%- include('../../partials/head', { title: 'Editar servicio' }) %>
  <body>
    <div class="layout">
      <%- include('../../partials/sidebar') %>

      <main class="main-content">
        <%- include('../../partials/header', { title: 'Editar servicio' }) %>

        <section class="content-box">
          <div class="topbar mb-md">
            <div>
              <h2 class="mb-sm">✏️ Editar servicio</h2>
              <p class="text-muted">Modificá los datos del servicio y sus imágenes de ejemplo.</p>
            </div>
            <div class="page-actions">
              <a href="/landing" class="btn btn-secondary">← Volver</a>
            </div>
          </div>

          <% if (error) { %>
            <div class="alert alert-error mb-md"><%= error %></div>
          <% } %>

          <form method="POST" action="/landing/servicios/<%= servicio.id %>/editar" enctype="multipart/form-data">
            <div class="form-group">
              <label class="form-label">Título <span class="text-muted">(obligatorio)</span></label>
              <input type="text" name="titulo" value="<%= servicio.titulo %>" required>
            </div>

            <div class="form-group">
              <label class="form-label">Descripción</label>
              <textarea name="descripcion" rows="4"><%= servicio.descripcion || '' %></textarea>
            </div>

            <div class="form-group">
              <label class="form-label">Orden de aparición</label>
              <input type="number" name="orden" value="<%= servicio.orden %>" min="0" style="max-width: 100px;">
              <small class="text-muted">Los servicios se muestran de menor a mayor orden.</small>
            </div>

            <div class="form-group">
              <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input type="checkbox" name="activo" <%= servicio.activo ? 'checked' : '' %>>
                <span>Visible en la landing</span>
              </label>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Guardar cambios</button>
              <a href="/landing" class="btn btn-secondary">Cancelar</a>
            </div>
          </form>

          <!-- IMÁGENES DE EJEMPLO -->
          <hr>
          <div class="topbar mb-md" style="margin-top: var(--space-lg);">
            <div>
              <h3 class="mb-sm">📸 Imágenes de ejemplo</h3>
              <p class="text-muted">Estas fotos aparecen cuando una clienta toca el servicio en la landing.</p>
            </div>
          </div>

          <% if (imagenes.length === 0) { %>
            <p class="text-muted mb-md">No hay imágenes cargadas para este servicio.</p>
          <% } else { %>
            <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: var(--space-md);">
              <% imagenes.forEach(img => { %>
                <div style="position: relative; display: inline-block;">
                  <img
                    src="<%= img.imagen_url %>"
                    alt="Imagen servicio"
                    style="height: 100px; width: 100px; object-fit: cover; border-radius: 8px; border: 1px solid var(--color-border);"
                  >
                  <form method="POST" action="/landing/servicios/imagenes/<%= img.id %>/eliminar" style="position: absolute; top: 4px; right: 4px;">
                    <button
                      type="button"
                      style="background: rgba(0,0,0,0.6); color: white; border: none; border-radius: 4px; padding: 2px 6px; font-size: 11px; cursor: pointer;"
                      onclick="showConfirm('¿Eliminar esta imagen?', function() { document.querySelector('#form-img-<%= img.id %>').submit(); })"
                    >✕</button>
                  </form>
                  <form method="POST" action="/landing/servicios/imagenes/<%= img.id %>/eliminar" id="form-img-<%= img.id %>"></form>
                </div>
              <% }) %>
            </div>
          <% } %>

          <form method="POST" action="/landing/servicios/<%= servicio.id %>/editar" enctype="multipart/form-data">
            <div style="display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap;">
              <div class="form-group" style="flex: 1; min-width: 200px; margin-bottom: 0;">
                <label class="form-label">Agregar nueva imagen</label>
                <input type="file" name="imagen" accept="image/*">
              </div>
              <button type="submit" class="btn btn-primary">Subir imagen</button>
            </div>
            <!-- Campos ocultos para no perder los datos del servicio al subir imagen -->
            <input type="hidden" name="titulo" value="<%= servicio.titulo %>">
            <input type="hidden" name="descripcion" value="<%= servicio.descripcion || '' %>">
            <input type="hidden" name="orden" value="<%= servicio.orden %>">
            <% if (servicio.activo) { %>
              <input type="hidden" name="activo" value="on">
            <% } %>
          </form>

        </section>
      </main>
    </div>
  </body>
</html>