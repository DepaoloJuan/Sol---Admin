<!DOCTYPE html>
<html lang="es">
  <%- include('../partials/head', { title: 'Clientas Láser' }) %>
  <body>
    <div class="layout">
      <%- include('../partials/sidebar') %>
      <main class="main-content">
        <%- include('../partials/header', { title: 'Clientas Láser' }) %>

        <section class="content-box">
          <div class="topbar mb-md">
            <div>
              <h2 class="mb-sm">Clientas Láser</h2>
              <p class="text-muted">Gestioná las clientas de depilación definitiva.</p>
            </div>
          </div>

          <div class="toolbar-row">
            <form method="GET" action="/laser/clientas" class="filter-bar">
              <input class="w-auto" type="text" name="q"
                placeholder="Buscar por nombre o apellido" value="<%= q %>" />
              <button type="submit" class="btn btn-primary">Buscar</button>
              <a href="/laser/clientas" class="btn btn-secondary">Limpiar</a>
            </form>

            <div class="page-actions">
              <a href="/laser/clientas/nueva" class="btn btn-primary">+ Nueva clienta</a>
              <div class="action-menu">
                <button class="btn btn-secondary action-menu-btn-wide" type="button">📊 Excel ▾</button>
                <div class="action-menu-dropdown excel-dropdown">
                  <a href="/laser/clientas/exportar/excel">⬇️ Exportar Excel</a>
                  <div class="excel-import-item">
                    <form action="/laser/clientas/importar/excel" method="POST" enctype="multipart/form-data">
                      <label class="excel-import-label">⬆️ Importar Excel</label>
                      <input type="file" name="archivo" accept=".xlsx" required />
                      <button type="submit" class="btn btn-primary btn-sm" style="width:100%; margin-top: 6px;">Subir archivo</button>
                    </form>
                  </div>
                </div>
              </div>
              <a href="/laser" class="btn btn-secondary">← Volver</a>
            </div>
          </div>

          <!-- TABLA desktop -->
          <div class="table-wrapper mt-md cliente-table">
            <table>
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Apellido</th>
                  <th>Teléfono</th>
                  <th>Género</th>
                  <th>Notas</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% if (clientes.length === 0) { %>
                  <tr>
                    <td colspan="6" class="text-center">No se encontraron clientas</td>
                  </tr>
                <% } %>
                <% clientes.forEach(cliente => { %>
                  <tr>
                    <td><%= cliente.nombre %></td>
                    <td><%= cliente.apellido %></td>
                    <td><%= cliente.telefono %></td>
                    <td><%= cliente.genero === 'F' ? 'Femenino' : 'Masculino' %></td>
                    <td><%= cliente.notas || '' %></td>
                    <td>
                      <div class="action-menu">
                        <button class="action-menu-btn" type="button">⋮</button>
                        <div class="action-menu-dropdown">
                          <a href="/laser/clientas/<%= cliente.id %>/historial">📋 Historial</a>
                          <a href="/laser/clientas/<%= cliente.id %>/editar">✏️ Editar</a>
                          <button type="button" class="menu-item-danger"
                            onclick="showConfirm('¿Eliminar esta clienta?', function() { document.getElementById('form-eliminar-laser-<%= cliente.id %>').submit(); })">
                            🗑️ Eliminar
                          </button>
                        </div>
                      </div>
                      <form action="/laser/clientas/<%= cliente.id %>/eliminar" method="POST"
                        id="form-eliminar-laser-<%= cliente.id %>" style="display:none"></form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <!-- CARDS mobile -->
          <div class="cliente-cards mt-md">
            <% if (clientes.length === 0) { %>
              <p class="text-muted">No se encontraron clientas.</p>
            <% } %>
            <% clientes.forEach(cliente => { %>
              <div class="cliente-card-item">
                <div class="cliente-card-info">
                  <span class="cliente-card-nombre"><%= cliente.nombre %> <%= cliente.apellido %></span>
                  <span class="cliente-card-telefono"><%= cliente.telefono %></span>
                </div>
                <div class="action-menu">
                  <button class="action-menu-btn" type="button">⋮</button>
                  <div class="action-menu-dropdown">
                    <a href="/laser/clientas/<%= cliente.id %>/historial">📋 Historial</a>
                    <a href="/laser/clientas/<%= cliente.id %>/editar">✏️ Editar</a>
                    <button type="button" class="menu-item-danger"
                      onclick="showConfirm('¿Eliminar esta clienta?', function() { document.getElementById('form-eliminar-laser-<%= cliente.id %>').submit(); })">
                      🗑️ Eliminar
                    </button>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>

        </section>
      </main>
    </div>

    <script>
      document.addEventListener('click', function(e) {
        if (!e.target.closest('.action-menu')) {
          document.querySelectorAll('.action-menu.open').forEach(m => m.classList.remove('open'));
        }
      });
      document.querySelectorAll('.action-menu > button').forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          const menu = this.closest('.action-menu');
          const wasOpen = menu.classList.contains('open');
          document.querySelectorAll('.action-menu.open').forEach(m => m.classList.remove('open'));
          if (!wasOpen) menu.classList.add('open');
        });
      });
    </script>

    <% if (typeof flash !== 'undefined' && flash) { %>
      <% if (flash.accion) { %>
        <!-- Modal de confirmación -->
        <div id="modal-confirmar" style="display:flex; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
          <div style="background:var(--color-surface); border-radius:var(--radius-md); padding:var(--space-lg); max-width:440px; width:90%; display:flex; flex-direction:column; gap:var(--space-md);">
            <p style="font-size:15px; font-weight:600;"><%= flash.mensaje %></p>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
              <form action="<%= flash.accion.url %>" method="POST">
                <% if (flash.accion.extra) { %>
                  <% Object.entries(flash.accion.extra).forEach(([k,v]) => { %>
                    <input type="hidden" name="<%= k %>" value="<%= v %>" />
                  <% }) %>
                <% } %>
                <button type="submit" class="btn btn-danger"><%= flash.accion.texto %></button>
              </form>
              <% if (flash.tipo === 'warning') { %>
                <% const clientaId = flash.accion.url.split('/')[3]; %>
                <a href="/laser/clientas/<%= clientaId %>/historial?returnEliminar=true" class="btn btn-secondary">Ver historial</a>
              <% } %>
              <button type="button" class="btn btn-secondary" onclick="document.getElementById('modal-confirmar').style.display='none'">Cancelar</button>
            </div>
          </div>
        </div>
      <% } else { %>
        <script>
          document.addEventListener("DOMContentLoaded", function () {
            showToast("<%= flash.mensaje %>", "<%= flash.tipo %>");
          });
        </script>
      <% } %>
    <% } %>
      <%- include('../partials/footer') %>
</body>
</html>