<!DOCTYPE html>
<html lang="es">
  <%- include('../partials/head', { title: 'Nueva Clienta Láser' }) %>
  <body>
    <div class="layout">
      <%- include('../partials/sidebar') %>
      <main class="main-content">
        <%- include('../partials/header', { title: 'Nueva Clienta Láser' }) %>

        <section class="content-box">
          <h2>Nueva clienta láser</h2>
          <p class="text-muted mb-md">Cargá una nueva clienta de depilación definitiva.</p>

          <% if (error) { %>
          <script>
            document.addEventListener("DOMContentLoaded", function () {
              showToast("<%= error %>", "error");
            });
          </script>
          <% } %>

          <!-- BUSCADOR SALÓN -->
          <div class="mb-md" style="background: var(--color-surface-soft); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-md);">
            <label style="font-size: 13px; font-weight: 600; display: block; margin-bottom: 8px;">Importar desde clientas del salón <span class="text-muted">(opcional)</span></label>
            <div style="display: flex; gap: 8px;">
              <input type="text" id="buscar-salon-input" placeholder="Buscar por nombre o apellido..." style="flex: 1;" autocomplete="off" />
            </div>
            <div id="buscar-salon-resultados" style="margin-top: 8px; display: none; flex-direction: column; gap: 6px;"></div>
          </div>

          <form action="/laser/clientas/nueva" method="POST" class="turno-form">
            <div class="form-grid">
              <div>
                <label for="nombre">Nombre</label>
                <input id="nombre" type="text" name="nombre" />
              </div>
              <div>
                <label for="apellido">Apellido</label>
                <input id="apellido" type="text" name="apellido" />
              </div>
              <div>
                <label for="telefono">Teléfono</label>
                <input id="telefono" type="text" name="telefono" />
              </div>
              <div>
                <label for="genero">Género</label>
                <select id="genero" name="genero">
                  <option value="F">Femenino</option>
                  <option value="M">Masculino</option>
                </select>
              </div>
              <div style="grid-column: 1 / -1;">
                <label for="notas">Notas</label>
                <textarea id="notas" name="notas" rows="3" placeholder="Observaciones, tipo de piel, etc."></textarea>
              </div>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Guardar clienta</button>
              <a href="/laser/clientas" class="btn btn-secondary">Cancelar</a>
            </div>
          </form>
        </section>
      </main>
    </div>

    <script>
  const buscarInput = document.getElementById('buscar-salon-input');
  const resultadosDiv = document.getElementById('buscar-salon-resultados');
  let timeoutBuscar;

  buscarInput.addEventListener('input', function() {
    clearTimeout(timeoutBuscar);
    const q = this.value.trim();
    if (q.length < 2) {
      resultadosDiv.style.display = 'none';
      resultadosDiv.innerHTML = '';
      return;
    }
    timeoutBuscar = setTimeout(async () => {
      const res = await fetch(`/laser/clientas/buscar-salon?q=${encodeURIComponent(q)}`);
      const data = await res.json();
      if (data.length === 0) {
        resultadosDiv.innerHTML = '<p class="text-muted" style="font-size: 13px;">No se encontraron clientas.</p>';
      } else {
        resultadosDiv.innerHTML = data.map(c => `
          <button type="button"
            style="text-align: left; padding: 8px 12px; border-radius: var(--radius-sm); border: 1px solid var(--color-border); background: var(--color-surface); cursor: pointer; font-size: 13px; width: auto; align-self: flex-start;"
            onclick="importarClienta('${c.nombre}', '${c.apellido || ''}', '${c.telefono || ''}')">
            <strong>${c.nombre}${c.apellido ? ' ' + c.apellido : ''}</strong>${c.telefono ? ' — ' + c.telefono : ''}
          </button>
        `).join('');
      }
      resultadosDiv.style.display = 'flex';
    }, 300);
  });

  function importarClienta(nombre, apellido, telefono) {
    document.getElementById('nombre').value = nombre;
    document.getElementById('apellido').value = apellido;
    document.getElementById('telefono').value = telefono;
    buscarInput.value = '';
    resultadosDiv.style.display = 'none';
    resultadosDiv.innerHTML = '';
    showToast('Datos importados. Completá género y notas.', 'success');
  }
</script>

    <script>
      document.querySelector("form").addEventListener("submit", function(e) {
        const nombre = document.getElementById("nombre").value.trim();
        const apellido = document.getElementById("apellido").value.trim();
        const telefono = document.getElementById("telefono").value.trim();
        if (!nombre || !apellido || !telefono) {
          e.preventDefault();
          showToast("Nombre, apellido y teléfono son obligatorios.", "error");
        }
      });
    </script>
      <%- include('../partials/footer') %>
</body>
</html>