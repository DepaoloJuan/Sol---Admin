<!-- Overlay: toque fuera del menú para cerrar -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<aside class="sidebar" id="sidebar">

  <div class="sidebar-brand">
    <h2 class="sidebar-title">Sol Cantero</h2>
  </div>

  <nav class="sidebar-nav">
    <% if (user && user.rol === 'admin') { %>
      <a href="/admin">🏠 Inicio</a>
      <a href="/agenda">📅 Agenda</a>
      <a href="/clientes">👥 Clientes</a>
      <a href="/empleados">👩‍💼 Empleados</a>
      <a href="/servicios">✂️ Servicios</a>
      <a href="/reportes">📊 Reportes</a>
      <a href="/laser">🔆 Depi</a>
      <a href="/usuarios">🔑 Usuarios</a>
      <a href="/landing">🌐 Landing</a>
      <a href="/asistente">🎙️ Asistente</a>
      <a href="/mis-fichas/lifting">💧 Lifting</a>
      <a href="/mis-fichas/extensiones">💫 Extensiones</a>
    <% } else { %>
      <a href="/mi-panel" style="display: flex; align-items: center; gap: 8px;">
        <% if (user && user.foto_url) { %>
          <img src="<%= user.foto_url %>" alt="" style="width: 22px; height: 22px; border-radius: 50%; object-fit: cover; flex-shrink: 0;" />
        <% } else { %>
          📋
        <% } %>
        <%= user ? user.nombre : "Mi Panel" %>
      </a>
      <% if (user && user.email === 'mili@centro.com') { %>
        <a href="/mis-fichas/lifting">💧 Lifting</a>
        <a href="/mis-fichas/extensiones">💫 Extensiones</a>
        <a href="/servicios">✂️ Servicios</a>
        <a href="/clientes">👥 Clientes</a>
      <% } %>
    <% } %>
  </nav>

  <% if (user) { %>
  <a href="/mi-perfil" class="sidebar-user" style="text-decoration: none; color: inherit;">
    <% if (user.foto_url) { %>
      <img src="<%= user.foto_url %>" alt="" class="sidebar-user-avatar" style="object-fit: cover;" />
    <% } else { %>
      <span class="sidebar-user-avatar"><%= user.nombre.charAt(0).toUpperCase() %></span>
    <% } %>
    <div class="sidebar-user-info">
      <span class="sidebar-user-name"><%= user.nombre %></span>
      <span class="sidebar-user-role"><%= user.titulo || (user.rol === 'admin' ? 'Administrador' : 'Empleada') %></span>
    </div>
  </a>
  <% } %>

</aside>

<script>
  (function () {
    const path = window.location.pathname;
    document.querySelectorAll('.sidebar-nav a').forEach(function (link) {
      const href = link.getAttribute('href');
      const isActive = href === '/admin'
        ? path === '/admin'
        : path.startsWith(href);
      if (isActive) link.classList.add('active');
    });
  })();
</script>
