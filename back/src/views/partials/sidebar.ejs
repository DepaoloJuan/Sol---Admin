<!-- Overlay: toque fuera del menú para cerrar -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<aside class="sidebar" id="sidebar">

  <div class="sidebar-brand">
    <h2 class="sidebar-title">Sol Cantero</h2>
  </div>

  <nav class="sidebar-nav">
    <% if (user && user.rol === 'admin') { %>
      <a href="/admin">🏠 Inicio</a>
      <a href="/agenda">📅 Agenda</a>
      <a href="/clientes">👥 Clientes</a>
      <a href="/servicios">✂️ Servicios</a>
      <a href="/reportes">📊 Reportes</a>
      <a href="/laser">🔆 Depi</a>
      <a href="/landing">🌐 Landing</a>
      <a href="/asistente">🎙️ Asistente</a>
      <div class="sidebar-group">
        <button type="button" class="sidebar-nav-toggle" data-target="submenu-lashista">
          <span>💅 Lashista</span>
          <span class="sidebar-nav-caret">▾</span>
        </button>
        <div class="sidebar-submenu" id="submenu-lashista">
          <a href="/mis-fichas/lifting">💧 Lifting</a>
          <a href="/mis-fichas/extensiones">💫 Extensiones</a>
        </div>
      </div>
    <% } else { %>
      <a href="/mi-panel" style="display: flex; align-items: center; gap: 8px;">
        <% if (user && user.foto_url) { %>
          <img src="<%= user.foto_url %>" alt="" style="width: 22px; height: 22px; border-radius: 50%; object-fit: cover; flex-shrink: 0;" />
        <% } else { %>
          📋
        <% } %>
        <%= user ? user.nombre : "Mi Panel" %>
      </a>
      <% if (user && user.email === 'mili@centro.com') { %>
        <div class="sidebar-group">
          <button type="button" class="sidebar-nav-toggle" data-target="submenu-lashista">
            <span>💅 Lashista</span>
            <span class="sidebar-nav-caret">▾</span>
          </button>
          <div class="sidebar-submenu" id="submenu-lashista">
            <a href="/mis-fichas/lifting">💧 Lifting</a>
            <a href="/mis-fichas/extensiones">💫 Extensiones</a>
          </div>
        </div>
        <a href="/servicios">✂️ Servicios</a>
        <a href="/clientes">👥 Clientes</a>
      <% } %>
    <% } %>
  </nav>

</aside>

<script>
  (function () {
    const path = window.location.pathname;

    document.querySelectorAll('.sidebar a[href]').forEach(function (link) {
      const href = link.getAttribute('href');
      const isActive = href === '/admin'
        ? path === '/admin'
        : path.startsWith(href);
      if (isActive) link.classList.add('active');
    });

    document.querySelectorAll('[data-target]').forEach(function (toggle) {
      const submenu = document.getElementById(toggle.getAttribute('data-target'));
      const grupo = toggle.closest('.sidebar-group');
      if (!submenu || !grupo) return;

      const tieneLinkActivo = Array.from(submenu.querySelectorAll('a')).some(function (a) {
        return a.classList.contains('active');
      });
      if (tieneLinkActivo) {
        grupo.classList.add('open');
        toggle.classList.add('active');
      }

      toggle.addEventListener('click', function () {
        grupo.classList.toggle('open');
      });
    });
  })();
</script>
