<!DOCTYPE html>
<html lang="es">
  <%- include('../partials/head', { title: 'Editar clienta' }) %>
  <body>
    <div class="layout">
      <%- include('../partials/sidebar') %>

      <main class="main-content">
        <%- include('../partials/header', { title: 'Editar clienta' }) %>

        <section class="content-box">
          <h2>Editar clienta</h2>
          <p class="text-muted mb-md">Actualizá los datos de la clienta.</p>

          <% if (error) { %>
            <p class="mb-md" style="color: var(--color-danger);"><%= error %></p>
          <% } %>

          <form action="/clientes/<%= cliente.id %>/editar" method="POST" class="turno-form">
            <div class="form-grid">
              <div>
                <label for="nombre">Nombre</label>
                <input
                  id="nombre"
                  type="text"
                  name="nombre"
                  value="<%= cliente.nombre || '' %>"
                />
              </div>

              <div>
                <label for="apellido">Apellido</label>
                <input
                  id="apellido"
                  type="text"
                  name="apellido"
                  value="<%= cliente.apellido || '' %>"
                />
              </div>

              <div>
                <label for="telefono">Teléfono</label>
                <input
                  id="telefono"
                  type="text"
                  name="telefono"
                  value="<%= cliente.telefono || '' %>"
                />
              </div>

              <div>
                <label for="dia_cumple">Día de cumpleaños <span class="text-muted">(opcional)</span></label>
                <input id="dia_cumple" type="number" name="dia_cumple" min="1" max="31" placeholder="Ej: 15" value="<%= cliente.dia_cumple || '' %>">
              </div>

              <div>
                <label for="mes_cumple">Mes de cumpleaños <span class="text-muted">(opcional)</span></label>
                <select id="mes_cumple" name="mes_cumple">
                  <option value="">-- Sin mes --</option>
                  <option value="1" <%= cliente.mes_cumple == 1 ? 'selected' : '' %>>Enero</option>
                  <option value="2" <%= cliente.mes_cumple == 2 ? 'selected' : '' %>>Febrero</option>
                  <option value="3" <%= cliente.mes_cumple == 3 ? 'selected' : '' %>>Marzo</option>
                  <option value="4" <%= cliente.mes_cumple == 4 ? 'selected' : '' %>>Abril</option>
                  <option value="5" <%= cliente.mes_cumple == 5 ? 'selected' : '' %>>Mayo</option>
                  <option value="6" <%= cliente.mes_cumple == 6 ? 'selected' : '' %>>Junio</option>
                  <option value="7" <%= cliente.mes_cumple == 7 ? 'selected' : '' %>>Julio</option>
                  <option value="8" <%= cliente.mes_cumple == 8 ? 'selected' : '' %>>Agosto</option>
                  <option value="9" <%= cliente.mes_cumple == 9 ? 'selected' : '' %>>Septiembre</option>
                  <option value="10" <%= cliente.mes_cumple == 10 ? 'selected' : '' %>>Octubre</option>
                  <option value="11" <%= cliente.mes_cumple == 11 ? 'selected' : '' %>>Noviembre</option>
                  <option value="12" <%= cliente.mes_cumple == 12 ? 'selected' : '' %>>Diciembre</option>
                </select>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Guardar cambios</button>
              <a href="/clientes" class="btn btn-secondary">Cancelar</a>
            </div>
          </form>
        </section>
      </main>
    </div>
  <script>
    document.querySelector("form").addEventListener("submit", function(e) {
      const nombre = document.getElementById("nombre").value.trim();
      const apellido = document.getElementById("apellido").value.trim();
      const telefono = document.getElementById("telefono").value.trim();

      if (!nombre || !apellido || !telefono) {
        e.preventDefault();
        showToast("Nombre, apellido y teléfono son obligatorios.", "error");
      }
    });
  </script>
      <%- include('../partials/footer') %>
</body>
</html>