<!DOCTYPE html>
<html lang="es">
  <%- include('../partials/head', { title: title }) %>
  <body>
    <div class="layout">
      <%- include('../partials/sidebar') %>

      <main class="main-content">
        <%- include('../partials/header', { title: title }) %>

        <section class="content-box">
          <div class="topbar mb-md">
            <div>
              <h1 class="mb-sm">📋 Historial de clienta</h1>
              <p class="text-muted">
                Últimos 10 turnos de
                <strong><%= cliente.nombre %> <%= cliente.apellido || "" %></strong>
              </p>
            </div>
            <div class="page-actions">
              <a href="/clientes" class="btn btn-secondary">← Volver al listado</a>
            </div>
          </div>

          <% if (premiosSinCanjear && premiosSinCanjear.length > 0) { %>
            <div class="content-box mb-md" style="background: rgba(197, 168, 128, 0.12); box-shadow: none;">
              <h3 class="mb-sm">🎁 Premios de fidelización sin canjear</h3>
              <% premiosSinCanjear.forEach(p => { %>
                <div class="table-actions mb-sm" style="justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                  <p style="margin: 0;">
                    <strong>Sello <%= p.sello_numero %>:</strong> <%= p.descripcion %>
                    <span class="text-muted" style="font-size: 12px;">
                      (ganado el <%= new Date(p.created_at).toLocaleDateString('es-AR') %>)
                    </span>
                  </p>
                  <form
                    action="/fidelidad/premios/<%= p.id %>/canjear"
                    method="POST"
                    class="inline-form"
                    id="form-canjear-<%= p.id %>"
                  >
                    <input type="hidden" name="returnTo" value="/clientes/<%= cliente.id %>/historial">
                    <button
                      type="button"
                      class="btn btn-primary btn-sm"
                      onclick="showConfirm('¿Confirmás que ya le entregaste este premio a la clienta?', function() { document.getElementById('form-canjear-<%= p.id %>').submit(); })"
                    >Marcar canjeado</button>
                  </form>
                </div>
              <% }) %>
            </div>
          <% } %>

          <% if (turnos.length === 0) { %>
            <p class="text-muted">Esta clienta no tiene turnos registrados.</p>
          <% } else { %>
            <div class="table-wrapper">
              <table>
                <thead>
                  <tr>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Servicio</th>
                    <th>Empleada</th>
                    <th>Duración</th>
                    <th>Costo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <% turnos.forEach(t => { %>
                    <tr>
                      <td><%= new Date(new Date(t.fecha).toISOString().slice(0,10) + 'T12:00:00').toLocaleDateString('es-AR') %></td>
                      <td><%= t.hora %></td>
                      <td><%= t.servicio_descripcion %></td>
                      <td><%= t.empleado_nombre %> <%= t.empleado_apellido || "" %></td>
                      <td><%= t.duracion %> min</td>
                      <td>$<%= Number(t.costo || 0).toLocaleString() %></td>
                      <td><%= t.estado %></td>
                      <td>
                        <% if (t.estado === 'Pagado' && cuentaVinculada && !t.tieneSello) { %>
                          <form
                            action="/fidelidad/turnos/<%= t.id %>/otorgar-sello"
                            method="POST"
                            class="inline-form"
                            id="form-sello-<%= t.id %>"
                          >
                            <input type="hidden" name="returnTo" value="/clientes/<%= cliente.id %>/historial">
                            <button
                              type="button"
                              class="btn btn-secondary btn-sm"
                              onclick="showConfirm('¿Confirmás que este turno debe sumar un sello de fidelización?', function() { document.getElementById('form-sello-<%= t.id %>').submit(); })"
                            >Otorgar sello</button>
                          </form>
                        <% } else { %>
                          —
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>

          <div class="content-box mt-md" style="background: var(--color-surface-soft); box-shadow: none;">
            <h3 class="mb-sm">📝 Anotaciones</h3>

            <form action="/clientes/<%= cliente.id %>/notas" method="POST" class="mb-md">
              <textarea
                name="texto"
                rows="3"
                placeholder="Dejá una anotación (ej. reacción, preferencia, observación)..."
                style="width: 100%; resize: vertical;"
              ></textarea>
              <div class="form-actions mt-sm">
                <button type="submit" class="btn btn-primary">Agregar anotación</button>
              </div>
            </form>

            <% if (notas.length === 0) { %>
              <p class="text-muted">Todavía no hay anotaciones para esta clienta.</p>
            <% } else { %>
              <% notas.forEach(nota => { %>
                <div class="content-box mb-sm" style="padding: 12px;">
                  <p style="margin: 0 0 4px;"><%= nota.texto %></p>
                  <p class="text-muted" style="margin: 0; font-size: 12px;">
                    <%= new Date(nota.created_at).toLocaleString('es-AR') %>
                    <% if (nota.autor_nombre || nota.autor_email) { %>
                      · <%= nota.autor_nombre || nota.autor_email %>
                    <% } %>
                  </p>
                </div>
              <% }) %>
            <% } %>
          </div>

        </section>
      </main>
    </div>

  <% if (typeof flash !== 'undefined' && flash) { %>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      showToast("<%= flash.mensaje %>", "<%= flash.tipo %>");
    });
  </script>
  <% } %>
      <%- include('../partials/footer') %>
</body>
</html>