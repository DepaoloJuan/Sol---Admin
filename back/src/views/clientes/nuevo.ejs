<!DOCTYPE html>
<html lang="es">
  <%- include('../partials/head', { title: 'Nueva clienta' }) %>
  <body>
    <div class="layout">
      <%- include('../partials/sidebar') %>

      <main class="main-content">
        <%- include('../partials/header', { title: 'Nueva clienta' }) %>

        <section class="content-box">
          <h2>Crear clienta</h2>
          <p class="text-muted mb-md">Cargá una nueva clienta en el sistema.</p>

          <% if (error) { %>
            <p class="mb-md" style="color: var(--color-danger);"><%= error %></p>
          <% } %>

          <form action="/clientes/nuevo" method="POST" class="turno-form">
            <input type="hidden" name="returnTo" value="<%= returnTo %>">
            <input type="hidden" name="fecha" value="<%= fecha %>">
            <input type="hidden" name="hora" value="<%= hora %>">
            <input type="hidden" name="empleado" value="<%= empleado %>">
            <input type="hidden" name="servicioId" value="<%= servicioId %>">

            <div class="form-grid">
              <div>
                <label for="nombre">Nombre</label>
                <input id="nombre" type="text" name="nombre">
              </div>

              <div>
                <label for="apellido">Apellido</label>
                <input id="apellido" type="text" name="apellido">
              </div>

              <div>
                <label for="telefono">Teléfono</label>
                <input id="telefono" type="text" name="telefono">
              </div>

              <div>
                <label for="dia_cumple">Día de cumpleaños <span class="text-muted">(opcional)</span></label>
                <input id="dia_cumple" type="number" name="dia_cumple" min="1" max="31" placeholder="Ej: 15">
              </div>

              <div>
                <label for="mes_cumple">Mes de cumpleaños <span class="text-muted">(opcional)</span></label>
                <select id="mes_cumple" name="mes_cumple">
                  <option value="">-- Sin mes --</option>
                  <option value="1">Enero</option>
                  <option value="2">Febrero</option>
                  <option value="3">Marzo</option>
                  <option value="4">Abril</option>
                  <option value="5">Mayo</option>
                  <option value="6">Junio</option>
                  <option value="7">Julio</option>
                  <option value="8">Agosto</option>
                  <option value="9">Septiembre</option>
                  <option value="10">Octubre</option>
                  <option value="11">Noviembre</option>
                  <option value="12">Diciembre</option>
                </select>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Guardar clienta</button>

              <a
                href="<%= returnTo %>?fecha=<%= fecha %>&hora=<%= hora %>&empleado=<%= empleado %>"
                class="btn btn-secondary"
              >
                Cancelar
              </a>
            </div>
          </form>
        </section>
      </main>
    </div>
  <script>
    document.querySelector("form").addEventListener("submit", function(e) {
      const nombre = document.getElementById("nombre").value.trim();
      const apellido = document.getElementById("apellido").value.trim();
      const telefono = document.getElementById("telefono").value.trim();

      if (!nombre || !apellido || !telefono) {
        e.preventDefault();
        showToast("Nombre, apellido y teléfono son obligatorios.", "error");
      }
    });
  </script>
  </body>
</html>